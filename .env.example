# .env.example — copy to .env and fill in your values
# Default setup uses SQLite (no config needed)

# PostgreSQL (optional — swap in load.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailco_dw
DB_USER=your_user
DB_PASSWORD=your_password

# BigQuery (optional)
GCP_PROJECT_ID=your-project-id
BQ_DATASET=retailco

# AWS (optional)
AWS_REGION=eu-west-1
S3_BUCKET=your-bucket-name
